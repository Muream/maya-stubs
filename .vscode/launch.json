    "version": "0.2.0",
    "configurations": [
        {
            "name": "maya-stubgen: Debug",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/packages/maya-stubgen",
            "args": [
                "build",
                "cmds",
                "--out", "${workspaceFolder}/src",
                "--cache", "${workspaceFolder}/.cache"
            ]
        }
